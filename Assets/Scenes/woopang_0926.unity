--- !u!114 &840110381
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 840110379}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e7c3f1186e3a00d47981e023e6cee4fe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::R0926LocalizedText
  ko: "\uBCF4\uBB3C\uC744 \uCC3E\uC558\uAC70\uB098 \uAC8C\uC784 \uC911 1km \uC548\uAE4C\uC9C0
    \uAC04 \uCC38\uAC00\uC790\uB9CC \uB0A8\uAE38 \uC218 \uC788\uC5B4\uC694 \xB7 \uC4F4
    \uC0AC\uB78C\uC740 \uC8FC\uCD5C\uC790\uC5D0\uAC8C \uBCF4\uC774\uC9C0 \uC54A\uC544\uC694"
  en: "Only players who found it or got within 1km can rate \xB7 The host can't see
    who wrote it"
  ja: "\u5B9D\u3092\u898B\u3064\u3051\u305F\u304B\u3001\u30B2\u30FC\u30E0\u4E2D\u306B1km\u4EE5\u5185\u307E\u3067\u8FD1\u3065\u3044\u305F\u53C2\u52A0\u8005\u3060\u3051\u304C\u8A55\u4FA1\u3067\u304D\u307E\u3059
    \xB7 \u66F8\u3044\u305F\u4EBA\u306F\u4E3B\u50AC\u8005\u306B\u8868\u793A\u3055\u308C\u307E\u305B\u3093"
  zh: "\u53EA\u6709\u627E\u5230\u5B9D\u85CF\u6216\u6E38\u620F\u4E2D\u5230\u8FC7 1km
    \u8303\u56F4\u5185\u7684\u53C2\u52A0\u8005\u624D\u80FD\u8BC4\u5206 \xB7 \u4E3B\u529E\u8005\u770B\u4E0D\u5230\u662F\u8C01\u5199\u7684"
  es: "Solo pueden valorar quienes lo encontraron o se acercaron a menos de 1 km
    \xB7 Quien organiza no ve qui\xE9n lo escribi\xF3"
