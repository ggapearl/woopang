  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::R0926LocalizedText
  ko: "\uC9C0\uAE08 \uC774 \uC790\uB9AC\uC5D0 \uBCF4\uBB3C \uC228\uAE30\uAE30\n<size=40>\uBCF4\uBB3C\uC740
    \uC9C0\uAE08 \uC11C \uC788\uB294 \uC790\uB9AC\uC5D0 \xB7 \uCC98\uC74C\uC5D4 \uC8FC\uCD5C
    \uC218\uCE59\uBD80\uD130</size>"
  en: "Hide a treasure right here\n<size=40>Placed where you stand \xB7 host rules
    first</size>"
  ja: "\u3053\u3053\u306B\u5B9D\u3092\u96A0\u3059\n<size=40>\u4ECA\u7ACB\u3063\u3066\u3044\u308B\u5834\u6240\u306B
    \xB7 \u306F\u3058\u3081\u306B\u4E3B\u50AC\u30EB\u30FC\u30EB\u3092\u78BA\u8A8D</size>"
  zh: "\u5728\u8FD9\u91CC\u85CF\u5B9D\n<size=40>\u5C31\u85CF\u5728\u4F60\u7AD9\u7684\u4F4D\u7F6E
    \xB7 \u5148\u770B\u4E3B\u529E\u89C4\u5219</size>"
  es: "Esconde un tesoro aqu\xED\n<size=40>Donde est\xE1s ahora \xB7 primero, las
    normas</size>"
