  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::R0926LocalizedText
  ko: "\uC774 \uD654\uBA74\uC740 \uC138\uB85C\uC5D0\uC11C \uC4F0\uAE30 \uD3B8\uD574\uC694\n\uD734\uB300\uD3F0\uC744
    \uC138\uB85C\uB85C \uB3CC\uB824 \uC8FC\uC138\uC694"
  en: 'This screen works best upright

    Please rotate your phone'
  ja: "\u3053\u306E\u753B\u9762\u306F\u7E26\u5411\u304D\u304C\u4F7F\u3044\u3084\u3059\u3044\u3067\u3059\n\u30B9\u30DE\u30DB\u3092\u7E26\u306B\u3057\u3066\u304F\u3060\u3055\u3044"
  zh: "\u6B64\u9875\u9762\u7AD6\u5C4F\u4F7F\u7528\u66F4\u65B9\u4FBF\n\u8BF7\u5C06\u624B\u673A\u7AD6\u8FC7\u6765"
  es: "Esta pantalla funciona mejor en vertical\nGira el tel\xE9fono"
