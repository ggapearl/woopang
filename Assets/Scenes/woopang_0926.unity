--- !u!114 &686353766
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 686353764}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e7c3f1186e3a00d47981e023e6cee4fe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::R0926LocalizedText
  ko: "\uC2E0\uACE0\uB294 \uC774 \uC0AC\uB78C \uAC8C\uC784\uC5D0 \uCC38\uAC00\uD55C
    \uC801\uC774 \uC788\uC5B4\uC57C \uD560 \uC218 \uC788\uC5B4\uC694 \xB7 \uCC28\uB2E8\uD558\uBA74
    \uC774 \uC0AC\uB78C \uAC8C\uC784\uC774 \uBAA9\uB85D\xB7\uC54C\uB9BC\uC5D0\uC11C
    \uC0AC\uB77C\uC838\uC694"
  en: "You can report only if you played this host's games \xB7 Blocking hides their
    hunts from your list and alerts"
  ja: "\u3053\u306E\u4EBA\u306E\u30B2\u30FC\u30E0\u306B\u53C2\u52A0\u3057\u305F\u3053\u3068\u304C\u3042\u308B\u5834\u5408\u306E\u307F\u901A\u5831\u3067\u304D\u307E\u3059
    \xB7 \u30D6\u30ED\u30C3\u30AF\u3059\u308B\u3068\u3053\u306E\u4EBA\u306E\u30B2\u30FC\u30E0\u304C\u4E00\u89A7\u30FB\u901A\u77E5\u304B\u3089\u6D88\u3048\u307E\u3059"
  zh: "\u53EA\u6709\u53C2\u52A0\u8FC7\u6B64\u4EBA\u7684\u6E38\u620F\u624D\u80FD\u4E3E\u62A5
    \xB7 \u5C4F\u853D\u540E\u6B64\u4EBA\u7684\u6E38\u620F\u5C06\u4ECE\u5217\u8868\u548C\u901A\u77E5\u4E2D\u6D88\u5931"
  es: "Solo puedes denunciar si jugaste a sus juegos \xB7 Al bloquear, sus b\xFAsquedas
    desaparecen de tu lista y avisos"
