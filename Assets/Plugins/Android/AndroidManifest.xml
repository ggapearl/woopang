<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" package="com.que.woopang" android:versionCode="1" android:versionName="1.0">
  <!-- 2026-10-30 Play 데이터 보안(1.2.58 반려) · 개인정보처리방침 8조 「광고 추적이나 행동 분석 도구를 쓰지 않습니다」:
       Firebase 알림(FCM)이 같이 끌고 오는 Analytics 가 넣는 광고 ID 권한을 뺀다 -->
  <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
  <application android:label="@string/app_name" android:icon="@drawable/app_icon">
    <!-- Analytics 는 쓰지 않는다 — 수집 끄기 (알림은 그대로) -->
    <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
    <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
    <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
    <!-- The MessagingUnityPlayerActivity is a class that extends
         UnityPlayerActivity to work around a known issue when receiving
         notification data payloads in the background. -->
    <activity android:name="com.google.firebase.MessagingUnityPlayerActivity" android:configChanges="fontScale|keyboard|keyboardHidden|locale|mnc|mcc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|touchscreen" android:launchMode="singleTask" android:exported="true" android:theme="@style/UnityThemeSelector">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- Deep Link for woopang://auth -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="woopang" android:host="auth" />
      </intent-filter>
      <!-- 보물찾기 공유 링크 woopang://hunt?id=…&c=… (woopang.com/hunt/<id> 의 '우팡 앱에서 열기') -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="woopang" android:host="hunt" />
      </intent-filter>
      <!-- 서버 FCM 알림의 click_action — 이 필터가 없으면 알림을 눌러도 앱이 열리지 않았다 -->
      <intent-filter>
        <action android:name="OPEN_MESSAGE_PANEL" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
      <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
    </activity>
    <service android:name="com.google.firebase.messaging.MessageForwardingService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true">
    </service>
    <!-- 앱이 꺼져 있을 때 FCM 알림의 상태바 아이콘 — 없으면 앱 아이콘(흰 바탕 네모)을 써 흰 네모로 보였다. 흰 실루엣은 WoopangNotify.androidlib -->
    <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_woopang" />
  </application>
</manifest>