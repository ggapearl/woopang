<!-- 우팡 자체 안드로이드 의존성 (External Dependency Manager 가 mainTemplate.gradle 에 넣는다).
     app-update: AutoUpdateChecker 가 Play 스토어에 새 버전이 실제로 올라왔는지 기기에서 확인하는 데 쓴다. -->
<dependencies>
  <androidPackages>
    <androidPackage spec="com.google.android.play:app-update:2.1.0">
      <repositories>
        <repository>https://maven.google.com</repository>
      </repositories>
    </androidPackage>
    <!-- 2026-10-30 Play SDK 안내(1.2.58): Google Play 서비스가 끌고 오던 androidx.activity 1.0.0 · fragment 1.1.0 을 안내 기준(1.2.0+ · 1.2.1+) 위로 -->
    <androidPackage spec="androidx.activity:activity:1.2.4">
      <repositories>
        <repository>https://maven.google.com</repository>
      </repositories>
    </androidPackage>
    <androidPackage spec="androidx.fragment:fragment:1.3.6">
      <repositories>
        <repository>https://maven.google.com</repository>
      </repositories>
    </androidPackage>
  </androidPackages>
</dependencies>
